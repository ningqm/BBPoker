# TODO: permanent HTTPS origin, e.g. https://poker.example.com
PUBLIC_ORIGIN=
# Set to loopback only behind a local proxy, with Node bound to 127.0.0.1.
# The proxy must overwrite X-BBPoker-Client-IP with the connection's client IP
# (Caddy: header_up X-BBPoker-Client-IP {remote_host}). Other forwarding headers
# are ignored. Leave blank for direct access or a non-loopback proxy.
TRUST_PROXY=
# Packaged apps only: explicitly allow their fixed origins. Blank keeps web-only access.
# CLIENT_ORIGINS=app://localhost,capacitor://localhost,https://localhost
CLIENT_ORIGINS=
# Optional private create-room passphrase. Required recommendation for a public instance.
CREATE_ROOM_KEY=
